<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      i18n:domain="senaite.core"
      tal:define="portal_url nocall:context/portal_url;
                  senaite_theme nocall:context/senaite_theme;
                  portal portal_url/getPortalObject;">
  <head>

    <link rel="stylesheet" type="text/css" media="all" href=""
          tal:attributes="href string:$portal_url/reports.css" />

    <script type="text/javascript"
            tal:attributes="src string:${portal/absolute_url}/++plone++senaite.core.static/modules/d3/d3.min.js"/>
    <script type="text/javascript"
              tal:attributes="src string:${portal/absolute_url}/++plone++bika.reports/js/bika.lims.plotter.js"/>


  </head>
  <body
    tal:define="report_content view/report_content;
                report_format python:report_content.get('formats', []);
                report_parms python:report_content.get('parms', []);
                report_headers python:report_content.get('headings', []);
                footlines python:report_content.get('footings', []);
                footnotes python:report_content.get('footnotes', []);
                datalines python:report_content.get('datalines', []);
                ">

    <h1 tal:condition="python:report_headers.get('header')">
      <span tal:content="python:report_headers['header']"/>
    </h1>

    <!-- <h2 tal:condition="python:report_headers.get('subheader')">
         <span tal:content="python:report_headers['subheader']"/>
         </h2>
    -->
    <div>
      <table
        class="bika-report-parms"
        summary="Parameters"
        cellpadding="0" cellspacing="0">
        <tal:parms tal:repeat="line report_parms">
          <tr>
            <td tal:content="python:line['title']"/>
            <td tal:content="python:line['value']"/>
          </tr>
        </tal:parms>
      </table>
    </div>

    <div>
      <table
        class="bika-report-table"
        summary="Results"
        cellpadding="0" cellspacing="0"
        tal:define="
               col_cnt python:report_format['columns'];
               col_heads python:report_format['col_heads'];">
        <thead>
          <tr>
            <th
              tal:repeat="col_head col_heads"
              tal:content="col_head">
            </th>
          </tr>
        </thead>

        <tbody>
          <metal:block tal:repeat="line datalines">
            <tr>
              <tal:column
                tal:repeat="i python:range(len(line))">
                <td class="" colspan=""
                    tal:define="
                           img_before python:line[i].get('img_before');
                           img_after python:line[i].get('img_after');
                           colspan python:line[i].get('colspan', 1);
                           class python:line[i].get('class');
                           "
                    tal:attributes="
                           class class;
                           colspan colspan">
                  <tal:img tal:condition="img_before">
                    <img src=""
                         style="width:8px"
                         tal:attributes="src string:${portal_url}/${img_before}" />
                    &nbsp
                  </tal:img>
                  <span tal:content="python:line[i]['value']"/>
                  <tal:img tal:condition="img_after">
                    <img src=""
                         style="width:8px"
                         tal:attributes="src string:${portal_url}/${img_after}" />
                    &nbsp
                  </tal:img>
                </td>
              </tal:column>
            </tr>
          </metal:block>
        </tbody>

        <tfoot>
          <metal:block tal:repeat="line footlines">
            <tr>
              <tal:column
                tal:repeat="i python:range(len(line))">
                <td class="" colspan=""
                    tal:define="
                           colspan python:line[i].get('colspan', 1);
                           class python:line[i].get('class');"
                    tal:attributes="
                           class class;
                           colspan colspan">
                  <span tal:content="python:line[i]['value']"/>
                </td>
              </tal:column>
            </tr>
          </metal:block>
        </tfoot>
      </table>
    </div>

    <tal:notes tal:repeat="note footnotes">
      <tal:note
        tal:repeat="i python:range(len(note))">
        <p class="discreet"
           tal:define="
                  img_before python:note[i].get('img_before');
                  img_after python:note[i].get('img_after');
                  colspan python:note[i].get('colspan', 1);
                  class python:note[i].get('class');
                  "
           tal:attributes="class class">
          <tal:img tal:condition="img_before">
            <img src=""
                 tal:attributes="src string:${portal_url}/${img_before}" />
            &nbsp
          </tal:img>
          <span tal:content="python:note[i]['value']"/>
          <tal:img tal:condition="img_after">
            <img src=""
                 tal:attributes="src string:${portal_url}/${img_after}" />
            &nbsp
          </tal:img>
        </p>
      </tal:note>
    </tal:notes>
    <tal:plot tal:condition="python: hasattr(view, 'plot_enabled') and view.plot_enabled or False">
      <div class="bika-report-plot" tal:attributes="data-report-content view/plot_data"/>
    </tal:plot>

  <script>
    function isValidCharacter(char) {
        const charCode = char.charCodeAt(0);
        return charCode >= 0 && charCode <= 255; // Valid ASCII range
    }

    function sanitizeInput(word) {
        let sanitizedString = '';
        for (let i = 0; i < word.length; i++) {
            if (isValidCharacter(word[i])) {
                sanitizedString += word[i]; // Keep valid characters
            } else if (word[i].charCodeAt(0) == 8722) {
                sanitizedString += "-"
            } else {
                // Invalid characters are skipped (not added to sanitizedString)
                console.error('Invalid char: ' + word[i] + ' = ' + word[i].charCodeAt(0));
            };
        }
        return sanitizedString;
    }

    function safeBtoa(word) {
      try {
        const sanitizedInput = sanitizeInput(word);
        return btoa(sanitizedInput); // Now it's safe to use btoa
      } catch (error) {
        console.error('Failed to sanitize  object:', error);
        throw error;
      }
    }

    function insertSVGAsObject(svgElement, targetContainer) {
      try {
        // Serialize the SVG to a string
        const svgData = new XMLSerializer().serializeToString(svgElement);
        
        // Ensure proper SVG data URL encoding (no need for base64 if using raw SVG)
        // b64 = btoa(unescape(encodeURIComponent(svgData)));
        b64 = safeBtoa(svgData);
        const svgDataUrl = 'data:image/svg+xml;base64,' + b64;
        
        // Create an object element with the data URL
        const objectElement = document.createElement('object');
        objectElement.setAttribute('type', 'image/svg+xml');
        objectElement.setAttribute('data', svgDataUrl);

        // Append object to the target container
        targetContainer.innerHTML = '';  // Clear existing content
        targetContainer.appendChild(objectElement);
        
        return objectElement;

      } catch (error) {
        console.error('Failed to insert SVG as object:', error);
        throw error;
      }
    }

    function renderPlot(el) {
      console.log('renderPlot ...')
      try {
        const config = JSON.parse(el.getAttribute('data-report-content'));
        const bikaPlot = new BikaPlot(config);

        const container = d3.select(el);
        container.selectAll("svg").remove();  // Clear existing SVGs
        container.selectAll("img").remove();  // Clear existing SVGs

        bikaPlot.build_plot(el);

        const svg = container.selectAll("svg")
        insertSVGAsObject(svg.node(), container.node())

      } catch (e) {
        console.error("renderPlot failed:", e);
      }
    };

    document.querySelectorAll('.bika-report-plot').forEach(el => {
      // Get data
      const data = JSON.parse(el.getAttribute('data-report-content'));
      console.log(data);

      // Create plotter instance
      const plotter = new D3LinePlotter(
        el,
        {
          // width: 800,
          // height: 400,
          // margin: { top: 20, right: 20, bottom: 40, left: 50 }
        });

      // Plot your data
      // plotter.plot(data);
      plotter.renderForPDF(data);
    });
  </script>


  </body>
</html>
